-- SPDX-License-Identifier: MPL-2.0
-- SQLDelight schema v1 for the Mixu local library database (library.db).

CREATE TABLE IF NOT EXISTS schema_migrations (
    version INTEGER NOT NULL PRIMARY KEY,
    applied_at TEXT NOT NULL,
    description TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS works (
    work_id TEXT NOT NULL PRIMARY KEY,
    canonical_title TEXT NOT NULL,
    primary_author TEXT NOT NULL,
    language_code TEXT NOT NULL DEFAULT 'und',
    created_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS editions (
    edition_id TEXT NOT NULL PRIMARY KEY,
    work_id TEXT,
    title TEXT NOT NULL,
    author TEXT NOT NULL,
    language_code TEXT NOT NULL DEFAULT 'und',
    identifier TEXT,
    format TEXT NOT NULL DEFAULT 'EPUB',
    spine_count INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    FOREIGN KEY (work_id) REFERENCES works(work_id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS book_assets (
    asset_id TEXT NOT NULL PRIMARY KEY,
    edition_id TEXT,
    format_code TEXT NOT NULL,
    media_type TEXT NOT NULL,
    sha256_checksum TEXT NOT NULL UNIQUE,
    byte_size INTEGER NOT NULL,
    local_storage_path TEXT NOT NULL,
    parser_version TEXT NOT NULL,
    format_metadata_json TEXT NOT NULL DEFAULT '{}',
    imported_at INTEGER NOT NULL,
    FOREIGN KEY (edition_id) REFERENCES editions(edition_id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_book_assets_sha256 ON book_assets(sha256_checksum);

CREATE TABLE IF NOT EXISTS library_items (
    book_id TEXT NOT NULL PRIMARY KEY,
    asset_id TEXT NOT NULL,
    edition_id TEXT,
    display_title TEXT NOT NULL,
    display_author TEXT NOT NULL,
    cover_path TEXT,
    cover_placeholder_color INTEGER NOT NULL DEFAULT -14796150,
    total_chapters INTEGER NOT NULL DEFAULT 0,
    added_at INTEGER NOT NULL,
    last_opened_at INTEGER NOT NULL DEFAULT 0,
    is_archived INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (asset_id) REFERENCES book_assets(asset_id) ON DELETE CASCADE,
    FOREIGN KEY (edition_id) REFERENCES editions(edition_id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_library_items_last_opened ON library_items(last_opened_at DESC);

CREATE TABLE IF NOT EXISTS reading_progress (
    book_id TEXT NOT NULL PRIMARY KEY,
    reading_locator_json TEXT NOT NULL,
    progression REAL NOT NULL DEFAULT 0.0,
    knowledge_horizon_ordinal INTEGER NOT NULL DEFAULT 0,
    graph_view_ordinal INTEGER NOT NULL DEFAULT 0,
    active_graph_pack_id TEXT,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY (book_id) REFERENCES library_items(book_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS bookmarks (
    bookmark_id TEXT NOT NULL PRIMARY KEY,
    book_id TEXT NOT NULL,
    locator_json TEXT NOT NULL,
    label TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    version INTEGER NOT NULL DEFAULT 1,
    is_tombstone INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (book_id) REFERENCES library_items(book_id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_bookmarks_book_id ON bookmarks(book_id, is_tombstone, created_at DESC);

CREATE TABLE IF NOT EXISTS user_overlays (
    overlay_id TEXT NOT NULL PRIMARY KEY,
    book_id TEXT NOT NULL,
    object_type TEXT NOT NULL,
    object_id TEXT NOT NULL,
    device_id TEXT,
    created_at TEXT NOT NULL,
    created_at_reveal INTEGER NOT NULL DEFAULT 0,
    kind TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    visibility TEXT NOT NULL DEFAULT 'FROM_CREATION',
    is_tombstone INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (book_id) REFERENCES library_items(book_id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_user_overlays_book_reveal ON user_overlays(book_id, created_at_reveal);

CREATE TABLE IF NOT EXISTS reader_settings (
    scope_key TEXT NOT NULL,
    setting_key TEXT NOT NULL,
    setting_value TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (scope_key, setting_key)
);

CREATE TABLE IF NOT EXISTS sync_outbox (
    mutation_id TEXT NOT NULL PRIMARY KEY,
    entity_table TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    operation TEXT NOT NULL,
    payload_json TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    synced_at INTEGER
);

selectSchemaVersion:
SELECT COALESCE(MAX(version), 0) FROM schema_migrations;

insertSchemaMigration:
INSERT OR REPLACE INTO schema_migrations(version, applied_at, description)
VALUES (?, ?, ?);

findAssetBySha256:
SELECT * FROM book_assets WHERE sha256_checksum = ? LIMIT 1;

selectAllLibraryItems:
SELECT
    li.book_id,
    li.asset_id,
    li.edition_id,
    li.display_title,
    li.display_author,
    li.cover_path,
    li.cover_placeholder_color,
    li.total_chapters,
    li.added_at,
    li.last_opened_at,
    li.is_archived,
    rp.reading_locator_json,
    rp.progression,
    rp.knowledge_horizon_ordinal,
    rp.graph_view_ordinal
FROM library_items li
LEFT JOIN reading_progress rp ON rp.book_id = li.book_id
WHERE li.is_archived = 0
ORDER BY li.last_opened_at DESC, li.added_at DESC, li.display_title ASC;

selectLastReadBooks:
SELECT
    li.book_id,
    li.asset_id,
    li.edition_id,
    li.display_title,
    li.display_author,
    li.cover_path,
    li.cover_placeholder_color,
    li.total_chapters,
    li.added_at,
    li.last_opened_at,
    li.is_archived,
    rp.reading_locator_json,
    rp.progression,
    rp.knowledge_horizon_ordinal,
    rp.graph_view_ordinal
FROM library_items li
LEFT JOIN reading_progress rp ON rp.book_id = li.book_id
WHERE li.is_archived = 0 AND li.last_opened_at > 0
ORDER BY li.last_opened_at DESC, li.display_title ASC
LIMIT ?;

selectReadingProgress:
SELECT * FROM reading_progress WHERE book_id = ?;

upsertReadingProgress:
INSERT OR REPLACE INTO reading_progress(
    book_id,
    reading_locator_json,
    progression,
    knowledge_horizon_ordinal,
    graph_view_ordinal,
    active_graph_pack_id,
    updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?);

selectBookmarksForBook:
SELECT * FROM bookmarks
WHERE book_id = ? AND is_tombstone = 0
ORDER BY created_at DESC, bookmark_id ASC;

upsertBookmark:
INSERT OR REPLACE INTO bookmarks(
    bookmark_id,
    book_id,
    locator_json,
    label,
    created_at,
    updated_at,
    version,
    is_tombstone
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

tombstoneBookmark:
UPDATE bookmarks
SET is_tombstone = 1, updated_at = ?, version = version + 1
WHERE bookmark_id = ?;

selectReaderSettingsForScope:
SELECT setting_key, setting_value FROM reader_settings WHERE scope_key = ?;

upsertReaderSetting:
INSERT OR REPLACE INTO reader_settings(scope_key, setting_key, setting_value, updated_at)
VALUES (?, ?, ?, ?);
